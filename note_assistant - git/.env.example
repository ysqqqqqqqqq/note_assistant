# Optional generation; browser uses its Settings separately
DASHSCOPE_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# Empty = explicit BM25/RRF fallback. Set local paths for fully offline models.
RAG_DENSE_MODEL=
RAG_RERANKER_MODEL=
# Suggested: BAAI/bge-small-zh-v1.5 and BAAI/bge-reranker-base
RAG_TOP_K=3
RAG_CANDIDATE_K=30
RAG_CHUNK_SIZE=600
RAG_OVERLAP=100
RAG_CONTEXT_CHARS=3000
RAG_CACHE_SIZE=128
PORT=5000

RAG_DENSE_LANGUAGE=auto
RAG_RERANKER_LANGUAGE=auto
RAG_MIN_DENSE_SCORE=0.35
RAG_REWRITE_WEIGHT=0.5
